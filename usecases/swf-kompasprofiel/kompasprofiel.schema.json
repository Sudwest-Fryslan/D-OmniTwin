{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "name": "kompasprofiel",
  "title": "Kompasprofiel (beheer): plek van elke indicator in de hiërarchie",
  "description": "Eén regel = één indicator op één plek in een kompasprofiel (kwadrant › thema › onderdeel › extra niveau). Een indicator mag op meer plekken staan. Doel: kompas_configuraties, kompas_titels, kompas_themas, kompas_onderdelen, kompas_indicator_mapping.",
  "fields": [
    {
      "name": "profiel",
      "type": "string",
      "constraints": {
        "required": true,
        "maxLength": 100
      }
    },
    {
      "name": "gebiedstype_id",
      "type": "string",
      "format": "uuid",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "kwadrant",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "thema",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "onderdeel",
      "type": "string"
    },
    {
      "name": "extra_niveau",
      "type": "string"
    },
    {
      "name": "indicator_uuid",
      "type": "string",
      "format": "uuid",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "indicator_naam",
      "type": "string"
    },
    {
      "name": "classificatie",
      "type": "string",
      "constraints": {
        "enum": [
          "percentielklasse",
          "label"
        ]
      }
    }
  ],
  "missingValues": [
    ""
  ]
}
