{
  "id": "swf-kompas-klimaat",
  "beschrijving": {
    "@context": "https://data.overheid.nl/dcat-ap-nl/context.jsonld",
    "@type": "dcat:Dataset",
    "dct:title": "Kompasprofiel SWF Klimaat",
    "dct:description": "De Klimaatmonitor: 3 thema's (hemelwateroverlast, hittestress, droogte) met 10 indicatoren, op welstandsgebieden × buurt, met labels A–E.",
    "dct:publisher": "https://identifier.overheid.nl/tooi/id/gemeente/gm1900",
    "dct:accessRights": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED",
    "dct:license": "http://standaarden.overheid.nl/owms/terms/licentieonbekend",
    "dct:spatial": "https://identifier.overheid.nl/tooi/id/gemeente/gm1900",
    "dct:source": "Voortgangslijst basismonitor (data-team SWF) en definities DMART_BASISMONITOR",
    "dcat:theme": [
      "http://standaarden.overheid.nl/owms/terms/Bestuur"
    ],
    "dcat:keyword": [
      "kompas",
      "gebiedsmonitor"
    ],
    "dcat:contactPoint": {
      "@type": "vcard:Organization",
      "vcard:fn": "Functioneel beheer gebiedsmonitor, gemeente Súdwest-Fryslân"
    }
  },
  "bron": {
    "adapter": "usecase-bestand",
    "pad": "klimaat-indicatoren.json",
    "omschrijving": "de 10 klimaatindicatoren (docs/1-visie-concept/huidige-gebiedsmonitor/indicatoren.md); met ${SWF_DB_DUMP} de variant monitor-database"
  },
  "bewerkingen": [
    {
      "constant": {
        "profiel": "SWF Klimaat",
        "gebiedstype_id": "29fc9f28-89d9-488b-bf68-2ed176187b21",
        "kwadrant": "Klimaat",
        "classificatie": "label"
      }
    },
    {
      "behoud": [
        "profiel",
        "gebiedstype_id",
        "kwadrant",
        "thema",
        "indicator_uuid",
        "indicator_naam",
        "classificatie"
      ]
    }
  ],
  "levering": {
    "formaat": "datapackage",
    "bestand": "swf-kompas-klimaat.zip",
    "schema": {
      "kompasprofiel": "kompasprofiel.schema.json"
    }
  },
  "varianten": {
    "monitor-database": {
      "omschrijving": "de Klimaatmonitor zoals hij nu in de monitor staat (#316): actieve configuratie uit de database-dump. Heeft voorrang als SWF_DB_DUMP gezet is.",
      "als_beschikbaar": true,
      "bron": {
        "adapter": "lokaal-bestand",
        "pad": "${SWF_DB_DUMP}/kompasprofiel_monitor.csv",
        "formaat": "csv",
        "omschrijving": "actieve monitorconfiguratie uit de database-dump (scripts/beheer/swf_monitor_dump.py); nooit in git"
      },
      "bewerkingen": [
        {
          "filter": {
            "veld": "gebiedstype_id",
            "gelijk": "29fc9f28-89d9-488b-bf68-2ed176187b21"
          }
        },
        {
          "hernoem": {
            "niveau1": "thema"
          }
        },
        {
          "id": "a4-waterdiepte",
          "waarde_map": {
            "veld": "indicator_uuid",
            "map": {
              "f6eafa70-9383-4de6-bd2a-e47309843437": "c4e1b3bb-e4ce-4cd0-bd52-219f4a9f5df3"
            }
          },
          "omschrijving": "Waterdiepte op straat: de vervallen UUID f6eafa70… (status B) wordt c4e1b3bb… (besluit https://github.com/Sudwest-Fryslan/D-OmniTwin/issues/341; de geldige monitors gebruiken al c4e1b3bb…)"
        },
        {
          "id": "definitie",
          "koppel": {
            "sleutel": "indicator_uuid",
            "op": "id",
            "bron": {
              "adapter": "lokaal-bestand",
              "pad": "${SWF_DB_DUMP}/definities.json",
              "formaat": "json"
            },
            "tabel": "indicatoren",
            "velden": {
              "naam": "_definitie"
            },
            "verplicht": true,
            "reden": "indicator-niet-in-definities"
          }
        },
        {
          "constant": {
            "profiel": "SWF Klimaat",
            "kwadrant": "Klimaat",
            "classificatie": "label"
          }
        },
        {
          "behoud": [
            "profiel",
            "gebiedstype_id",
            "kwadrant",
            "thema",
            "indicator_uuid",
            "indicator_naam",
            "classificatie"
          ]
        }
      ]
    }
  }
}
