{
  "id": "swf-monitor-definities",
  "bronId": "swf-monitor",
  "beschrijving": {
    "@context": "https://data.overheid.nl/dcat-ap-nl/context.jsonld",
    "@type": "dcat:Dataset",
    "dct:title": "Basismonitor Súdwest-Fryslân — definities",
    "dct:description": "Indicatoren, gebiedstypen en hun relaties van de gebiedsmonitor van Súdwest-Fryslân: altijd de volledige set uit de datamart DMART_BASISMONITOR.",
    "dct:publisher": "https://identifier.overheid.nl/tooi/id/gemeente/gm1900",
    "dct:accessRights": "http://publications.europa.eu/resource/authority/access-right/PUBLIC",
    "dct:license": "http://standaarden.overheid.nl/owms/terms/licentieonbekend",
    "dct:spatial": "https://identifier.overheid.nl/tooi/id/gemeente/gm1900",
    "dct:source": "Datamart DMART_BASISMONITOR, gemeente Súdwest-Fryslân (export van de huidige gebiedsmonitor)",
    "dcat:theme": [
      "http://standaarden.overheid.nl/owms/terms/Bestuur"
    ],
    "dcat:keyword": [
      "gebiedsmonitor",
      "indicatoren",
      "Súdwest-Fryslân"
    ],
    "dcat:contactPoint": {
      "@type": "vcard:Organization",
      "vcard:fn": "Functioneel beheer gebiedsmonitor, gemeente Súdwest-Fryslân"
    }
  },
  "laadprofiel": {
    "profiel": "definities",
    "adapter": "swf-monitor-v1",
    "plausibiliteit": {
      "maxDalingProcent": 10
    }
  },
  "bron": {
    "adapter": "swf-dump",
    "export": "definities",
    "omschrijving": "${SWF_DUMP_DIR}/output/api_backup_dump.json (GET …/monitor_api/indicator/setup); later ook ${SWF_DB_DUMP}"
  },
  "bewerkingen": [
    {
      "tabel": "indicatoren",
      "hernoem": {
        "id": "uuid"
      }
    },
    {
      "tabel": "indicatoren",
      "id": "status-a",
      "waarde_map": {
        "veld": "status",
        "map": {
          "A": "O"
        }
      },
      "omschrijving": "Aanname A2 (https://github.com/TLaan/D-OmniTwin/issues/222): A = actueel volgens de projectleider; D-OmniTwin kent C/O/B, dus A → O (in gebruik) tot de DWH-beheerder de codes bevestigt (O = operationeel of ontwikkeling is nog open). De klimaatset staat in swf-kompasprofiel."
    },
    {
      "tabel": "indicatoren",
      "id": "dubbele-naam",
      "ontdubbel": {
        "veld": "naam",
        "sleutel": "uuid",
        "normaliseer": true,
        "houd": {
          "Waterdiepte op straat": "f6eafa70-9383-4de6-bd2a-e47309843437",
          "Werkzamen": "7fd17589-46b6-460a-a1f6-ef421517ccb3"
        },
        "zet": {
          "status": "B"
        },
        "achtervoegsel": " (vervallen)",
        "reden": "dubbele-naam"
      },
      "omschrijving": "Aanname A4 (https://github.com/TLaan/D-OmniTwin/issues/222): twee UUID's met dezelfde naam. De voorkeur (de UUID die live is of waarden heeft) blijft; de andere krijgt status B en de naam '<naam> (vervallen)'. Een UUID wijzigen kan alleen SWF-beheer in DWH/FME."
    },
    {
      "tabel": "indicatoren",
      "iso_datumtijd": [
        "begingeldigheid",
        "eindgeldigheid"
      ]
    },
    {
      "tabel": "gebiedstypen",
      "koppel": {
        "sleutel": "id",
        "op": "id",
        "bron": {
          "adapter": "usecase-bestand",
          "pad": "gebiedstypen.json"
        },
        "velden": {
          "code": "code",
          "niveau": "niveau",
          "gebiedsindeling_dataset": "gebiedsindeling_dataset",
          "code_prefix": "code_prefix"
        },
        "verplicht": true,
        "reden": "gebiedstype-zonder-mapping"
      }
    },
    {
      "tabel": "relaties",
      "hernoem": {
        "indicator_id": "indicator_uuid"
      }
    }
  ],
  "levering": {
    "formaat": "datapackage",
    "bestand": "swf-monitor-definities.zip"
  },
  "varianten": {
    "status-a": {
      "omschrijving": "status A ongewijzigd, zoals de DWH hem levert: de laad-API hoort de levering af te keuren (schema-ongeldig)",
      "sla_over": [
        "status-a"
      ]
    }
  }
}
