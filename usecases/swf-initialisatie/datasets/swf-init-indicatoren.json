    "dcat:theme": [
      "http://standaarden.overheid.nl/owms/terms/Bestuur"
    ],
    "dcat:keyword": [
      "gebiedsmonitor",
      "indicatoren",
      "initialisatie",
      "Súdwest-Fryslân"
