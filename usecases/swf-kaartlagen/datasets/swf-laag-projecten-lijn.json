{
  "id": "swf-laag-projecten-lijn",
  "bronId": "swf-kaartlagen",
  "beschrijving": {
    "@context": "https://data.overheid.nl/dcat-ap-nl/context.jsonld",
    "@type": "dcat:Dataset",
    "dct:title": "Wat speelt er? Projecten (lijnen)",
    "dct:description": "Gemeentelijke projectlocaties uit GeoVisia (lijnen), zonder persoonsgegevens (groep Wat speelt er allemaal?).",
    "dct:publisher": "https://identifier.overheid.nl/tooi/id/gemeente/gm1900",
    "dct:accessRights": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED",
    "dct:license": "http://standaarden.overheid.nl/owms/terms/licentieonbekend",
    "dct:spatial": "https://identifier.overheid.nl/tooi/id/gemeente/gm1900",
    "dct:source": "Gemeente Súdwest-Fryslân, GeoVisia",
    "dcat:theme": [
      "http://standaarden.overheid.nl/owms/terms/Ruimtelijke_ordening"
    ],
    "dcat:keyword": [
      "kaartlaag",
      "Súdwest-Fryslân"
    ],
    "dct:conformsTo": "http://www.opengis.net/def/crs/EPSG/0/28992",
    "dcat:contactPoint": {
      "@type": "vcard:Organization",
      "vcard:fn": "Functioneel beheer gebiedsmonitor, gemeente Súdwest-Fryslân"
    }
  },
  "laadprofiel": {
    "profiel": "kaartlaag",
    "doel": {
      "featureTabel": "swf_laag_projecten_lijn",
      "sleutelveld": "id",
      "labelveld": "objectnaam"
    },
    "plausibiliteit": {
      "minRegels": 1
    }
  },
  "bron": {
    "adapter": "lokaal-bestand",
    "pad": "${SWF_DOCS_DIR}/Demo/Demo data/Projecten in de kaart/GEOVISIA_PROJECT_PROJECTLOCATIES.json",
    "crs": 4326,
    "omschrijving": "export uit GeoVisia (beheersysteem openbare ruimte); bevat persoonsvelden, die gaan er hier uit"
  },
  "bewerkingen": [
    {
      "geometrietype": [
        "LineString",
        "MultiLineString"
      ]
    },
    {
      "snake_case": true
    },
    {
      "behoud": [
        "id",
        "objectnaam",
        "kl_projectomschrijving",
        "projectstatus",
        "typeproject",
        "vakdiscipline",
        "begindatumvoorbereiding",
        "begindatumuitvoering",
        "opleverdatum",
        "woonplaats",
        "wijk",
        "buurt"
      ]
    }
  ],
  "levering": {
    "formaat": "geopackage",
    "bestand": "swf-laag-projecten-lijn.gpkg",
    "geometrie": "LineString"
  }
}
