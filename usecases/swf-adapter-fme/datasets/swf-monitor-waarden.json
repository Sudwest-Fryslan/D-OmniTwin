{
  "id": "swf-monitor-waarden",
  "bronId": "swf-monitor",
  "beschrijving": {
    "@context": "https://data.overheid.nl/dcat-ap-nl/context.jsonld",
    "@type": "dcat:Dataset",
    "dct:title": "Basismonitor Súdwest-Fryslân — indicatorwaarden",
    "dct:description": "Waarden van de indicatoren van de gebiedsmonitor per CBS-buurt, buurtdeel binnen/buiten de bebouwde kom en welstandsgebied × buurt, per jaar. Waarden op minder dan 10 waarnemingen laat de bron weg.",
    "dct:publisher": "https://identifier.overheid.nl/tooi/id/gemeente/gm1900",
    "dct:accessRights": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED",
    "dct:license": "http://standaarden.overheid.nl/owms/terms/licentieonbekend",
    "dct:spatial": "https://identifier.overheid.nl/tooi/id/gemeente/gm1900",
    "dct:source": "Datamart DMART_BASISMONITOR, gemeente Súdwest-Fryslân (export van de huidige gebiedsmonitor)",
    "dcat:theme": [
      "http://standaarden.overheid.nl/owms/terms/Sociale_zekerheid"
    ],
    "dcat:keyword": [
      "gebiedsmonitor",
      "indicatoren",
      "Súdwest-Fryslân"
    ],
    "dcat:contactPoint": {
      "@type": "vcard:Organization",
      "vcard:fn": "Functioneel beheer gebiedsmonitor, gemeente Súdwest-Fryslân"
    }
  },
  "laadprofiel": {
    "profiel": "waarnemingen",
    "adapter": "swf-monitor-v1",
    "vervangBereik": [
      "indicator_uuid",
      "gebiedstype"
    ],
    "minimumN": 10,
    "bijNOnderDrempel": "onderdrukken",
    "bijOntbrekendeN": "bron-onderdrukt",
    "plausibiliteit": {
      "maxDalingProcent": 20
    }
  },
  "bron": {
    "adapter": "swf-dump",
    "export": "waarden",
    "omschrijving": "zoals de FME-workspace voor de waarden per indicator × gebiedstype pusht"
  },
  "bewerkingen": [
    {
      "id": "jaar-0",
      "afwijzen": {
        "veld": "jaar",
        "gelijk": 0,
        "reden": "jaar-ongeldig"
      }
    },
    {
      "id": "onbekende-buurten",
      "afwijzen": {
        "veld": "gebieds_id",
        "in": [
          "BU19009997",
          "BU19009998"
        ],
        "reden": "gebied-onbekend"
      }
    },
    {
      "jaar_naar_datum": {
        "veld": "jaar",
        "naar": "begingeldigheid"
      }
    },
    {
      "constant": {
        "eindgeldigheid": null
      }
    },
    {
      "tekst": [
        "gebieds_id"
      ]
    }
  ],
  "levering": {
    "formaat": "swf-json",
    "bestand": "waarden"
  },
  "varianten": {
    "met-fouten": {
      "omschrijving": "met jaar 0 (begingeldigheid 0000-01-01): die aanroep hoort afgekeurd te worden",
      "sla_over": [
        "jaar-0",
        "onbekende-buurten"
      ]
    }
  }
}
