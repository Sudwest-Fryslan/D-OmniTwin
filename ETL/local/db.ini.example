# ============================================================
# D-OmniTwin ETL — Database Configuratie (LOKAAL)
# ============================================================
# Kopieer dit bestand naar: ETL/local/db.ini
# Het bestand db.ini staat in .gitignore (nooit committen!)
#
# Gebruik:
#   cp ETL/local/db.ini.example ETL/local/db.ini
#   nano ETL/local/db.ini   (of open in je editor)
#
# De scripts in ETL/local/ lezen automatisch dit bestand.
# ============================================================

[DATABASE]
# PostgreSQL host (localhost voor lokaal, IP of hostname voor remote)
host     = localhost

# PostgreSQL poort (standaard 5432)
port     = 5432

# Database naam
dbname   = omnitwin_db

# Database gebruiker
user     = omnitwin_user

# Database wachtwoord (NIET committen!)
password = jouw_wachtwoord_hier

# SSL mode: prefer / require / disable
sslmode  = prefer

# ============================================================
# Optioneel: alternatieve database voor test/productie
# ============================================================
# [DATABASE_PROD]
# host     = prod-server.jouwdomein.nl
# port     = 5432
# dbname   = omnitwin_prod
# user     = omnitwin_prod_user
# password = prod_wachtwoord
# sslmode  = require

[ETL]
# Gemeente codes om standaard te verwerken (komma-gescheiden CBS-codes)
# Laat leeg = alle gemeenten in de database
gemeente_codes = 1900,0090,1940,0059,0060,1891,0072,0074,1970,0085,0086,0088,0093,0737,0096,1949,0098

# Output map voor tijdelijke CBS JSON downloads
output_dir = ./output

# Jaar dat als standaard gebruikt wordt als het niet uit data kan worden afgeleid
default_jaar = 2023

[CBS]
# CBS OData endpoint (opendata.cbs.nl of dataderden.cbs.nl voor RIVM/Politie)
endpoint_public = opendata.cbs.nl
endpoint_derden = dataderden.cbs.nl

# Request timeout in seconden
timeout = 60

# Maximaal aantal retries bij tijdelijke fouten
max_retries = 3
