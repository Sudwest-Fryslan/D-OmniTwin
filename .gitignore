# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv
pip-log.txt
pip-delete-this-directory.txt

# Configuration
config.ini
.env
# Wachtwoorden en secrets van use-case-testaccounts (#223): alleen lokaal
.usecase-accounts.json

# Agents (intern AI-werkgeheugen, niet voor repository)
.agents/

# Claude Code (lokale instellingen, niet voor repository)
.claude/settings.local.json

# Data (volledige uitsluiting, bevat grote datasets)
data/
leveringen/
# Testdata (o.a. de evaluatieset van de assistent, #233) WEL in git
!tests/data/

# init_data staat WEL in git (publieke starter dataset)
!init_data/
# Brondata van een use case (usecases/<naam>/data/waarden.csv) ook
!usecases/*/data/
# Bewijs van een use case (#225): alleen het compacte bewijs in git (WebP-screenshots, bewijs.json,
# README); het volledige bewijs (bewijs/volledig/, controle.json, ...) gaat als zip bij de release
usecases/*/bewijs/*
!usecases/*/bewijs/README.md
!usecases/*/bewijs/*.webp
!usecases/*/bewijs/bewijs.json
!usecases/uitrol-kubernetes/bewijs/rooktest.json

# Exports (gegenereerde rapporten, JSON exports, Excel)
exports/

# Backups en databasedumps (installatie.md, Backup); nooit in git (#204)
backups/
*.dump

# E2E-testartefacten (screenshots bij fouten)
tests/e2e/artifacts/

# Logs
*.log
logs/

# Lokale oude bestanden
obsolete/

# Intern werkdocument
BRAINDUMP.md

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Docs: interne projectmappen (niet openbaar)
docs/4-ux-design/*
docs/5-secops/*
