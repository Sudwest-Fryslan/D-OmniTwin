# D-OmniTwin Environment Configuration — TEMPLATE
# Kopieer dit bestand naar .env en vul de waarden in:
#   cp .env.example .env
#
# ⚠️ COMMIT NOOIT het .env bestand! Alleen dit .env.example bestand hoort op Git.

# ─── Docker Compose ──────────────────────────────────────
# Installatie (geen dev): zet dit aan, dan laadt `docker compose` alleen de
# basis en niet docker-compose.override.yml (bind-mount, open DB-poort, dashboard).
# COMPOSE_FILE=docker-compose.yml
# HTTP-poort van Traefik op de host (standaard 80)
# OMNITWIN_HTTP_PORT=80

# ─── Database ────────────────────────────────────────────
# Deze waarden gelden voor scripts op de host (load_sample.py, ETL, run_dev.py).
# De containers negeren HOST/PORT en gebruiken postgres:5432 (zie docker-compose.yml).
# Dev-stack (docker compose up) publiceert de database op localhost:5433;
# gebruik 5432 alleen voor een PostgreSQL die rechtstreeks op de host draait.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=omnitwin_db
DATABASE_USER=omnitwin_user
DATABASE_PASSWORD=<jouw-database-wachtwoord>
DATABASE_SSLMODE=prefer  # 'require' voor productie, 'prefer' voor lokale ontwikkeling

# ─── API Security ─────────────────────────────────────────
# Genereer met: openssl rand -base64 32
SECRET_KEY=<genereer-met-openssl-rand-base64-32>

# Toegestane origins voor CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Basiskaart ───────────────────────────────────────────
# De kaart gebruikt MapLibre met PDOK-achtergrondkaarten. Geen token nodig.

# ─── App Instellingen ─────────────────────────────────────
DEBUG=true
# Automatisch sample dataset (12 SWF-buurten) laden als database leeg is bij container start
LOAD_SAMPLE_DATA=true
# Log niveau voor uvicorn + AppLogger (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Per-module niveaus instelbaar via admin panel (log_config tabel)
LOG_LEVEL=INFO

# ─── Admin Panel ──────────────────────────────────────────
# Genereer met: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=<genereer-met-python-secrets-token-hex-32>

# Admin gebruiker (applicatie login)
ADMIN_USER=admin
ADMIN_PASSWORD=<jouw-admin-wachtwoord>

# ─── Ollama / Lokale AI (optioneel) ───────────────────────
# Vanuit de backend-container is de host bereikbaar als host.docker.internal (extra_hosts in docker-compose.yml); draai je de backend buiten Docker, gebruik dan http://localhost:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:30b

# ─── LLM-koppeling: Ollama of OpenAI-compatibel (ADR 0001) ─
# Welke server de app gebruikt staat in de tabel llm_config (Admin → AI Configuratie):
#   api_type=ollama  Ollama-eigen API (standaard, zoals altijd)
#   api_type=openai  OpenAI Chat Completions: Ollama /v1, vLLM, LM Studio, LiteLLM, ...
# Alleen voor api_type=openai: API-sleutel als Bearer-token. Nooit in de database zetten.
# Via de LiteLLM-gateway: gebruik hier dezelfde waarde als LITELLM_MASTER_KEY.
LLM_API_KEY=
# Denk-modus van redeneermodellen (Qwen3, DeepSeek-R1). Standaard uit: korte teksten
# hebben geen redeneerstap nodig en denken kost minuten. true = het model beslist zelf.
# LLM_THINK=false
# Alleen api_type=openai: reasoning_effort bij denk-modus uit (standaard none).
# Leeg (LLM_REASONING_EFFORT=) laat het veld weg, voor servers die het weigeren.
# LLM_REASONING_EFFORT=none

# Optionele LiteLLM-gateway: docker compose --profile llm-gateway up -d
# Stuurt standaard door naar OLLAMA_HOST/OLLAMA_MODEL (deploy/litellm/config.yaml).
# Zet daarna in llm_config: api_type=openai, api_url=http://llm-gateway:4000,
# model_name=d-omnitwin-default.
# Moet met sk- beginnen. Genereer met: python -c "import secrets; print('sk-' + secrets.token_hex(24))"
LITELLM_MASTER_KEY=

# ─── E-mail Alerts (Sprint 17C — nog te implementeren, zie Issue #10) ────────
# Vereist eigen SMTP-server. Laat leeg om alerts uit te schakelen.
LOG_ALERT_ENABLED=false
LOG_ALERT_TO=beheer@jouwdomein.nl
SMTP_HOST=mail.jouwdomein.nl
SMTP_PORT=587
SMTP_USER=alerts@jouwdomein.nl
SMTP_PASS=<smtp-wachtwoord>
SMTP_FROM=D-OmniTwin Alerts <alerts@jouwdomein.nl>
