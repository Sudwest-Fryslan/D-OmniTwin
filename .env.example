# D-OmniTwin — configuratie
#
#   cp .env.example .env      en vul hieronder DATABASE_PASSWORD in.
#
# Al het andere heeft een werkende standaard. Commit .env nooit.
# Geheimen genereren: openssl rand -hex 24   (alleen letters en cijfers gebruiken)

# ─── Verplicht ───────────────────────────────────────────
DATABASE_PASSWORD=

# ─── Aanbevolen ──────────────────────────────────────────
# Wachtwoord van het eerste beheeraccount (gebruiker: admin).
# Leeg = er wordt eenmalig een wachtwoord gegenereerd, te vinden met: docker compose logs db-init
ADMIN_PASSWORD=

# Installatie: alleen de installatie-instellingen laden.
# Ontwikkelaars: deze regel weghalen (dan wordt ook docker-compose.override.yml geladen).
COMPOSE_FILE=docker-compose.yml

# Zonder HTTPS moet dit op true staan, anders werkt inloggen in de browser niet. Met HTTPS: false.
DEBUG=true

# ─── Optioneel (standaardwaarde staat erbij) ─────────────
# OMNITWIN_HTTP_PORT=80        # poort op de host
# LOAD_SAMPLE_DATA=true        # sample dataset (13 buurten Súdwest-Fryslân) bij de eerste start
# LOG_LEVEL=INFO
# ADMIN_USER=admin
# ADMIN_API_KEY=               # alleen voor scripts (header X-Admin-Key); leeg = uitgeschakeld
# OLLAMA_HOST=http://host.docker.internal:11434   # lokale AI; model kiezen in Beheer → AI Configuratie
# OLLAMA_MODEL=qwen3:30b-instruct                 # alleen als terugval als er in Beheer nog niets is ingesteld
# COMPOSE_PROJECT_NAME=d-omnitwin                 # alleen nodig voor meerdere stacks naast elkaar
# CORS_ORIGINS=http://localhost:8000              # alleen als andere websites de API aanroepen

# ─── Alleen voor ontwikkelaars (scripts op de host) ──────
# DATABASE_HOST=localhost
# DATABASE_PORT=5433
# DATABASE_NAME=omnitwin_db
# DATABASE_USER=omnitwin_user
# DATABASE_SSLMODE=prefer
