# D-OmniTwin — configuratie
#
#   cp .env.example .env      en vul hieronder DATABASE_PASSWORD in.
#
# Al het andere heeft een werkende standaard. Commit .env nooit.
# Geheimen genereren: openssl rand -hex 24   (alleen letters en cijfers gebruiken)
# Commentaar staat altijd op een eigen regel: tekst achter een waarde wordt soms als waarde gelezen.

# ─── Verplicht ───────────────────────────────────────────
DATABASE_PASSWORD=

# ─── Aanbevolen ──────────────────────────────────────────
# Wachtwoord van het eerste beheeraccount (gebruiker: admin).
# Leeg = er wordt eenmalig een wachtwoord gegenereerd, te vinden met: docker compose logs db-init
ADMIN_PASSWORD=

# Installatie: alleen de installatie-instellingen laden.
# Ontwikkelaars: deze regel weghalen (dan wordt ook docker-compose.override.yml geladen).
COMPOSE_FILE=docker-compose.yml

# ─── Optioneel (weghalen van # = aanzetten; de standaardwaarde staat erbij) ─
# Poort op de host
# OMNITWIN_HTTP_PORT=80
# Demodata laden bij de eerste start (false = product zonder data, klaar voor eigen data)
# LOAD_SAMPLE_DATA=true
# Logniveau: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# Naam van het eerste beheeraccount
# ADMIN_USER=admin
# Alleen voor scripts (header X-Admin-Key); leeg = uitgeschakeld
# ADMIN_API_KEY=
# Alleen nodig voor meerdere installaties op één machine
# COMPOSE_PROJECT_NAME=d-omnitwin
# Alleen als andere websites de API aanroepen: kommagescheiden lijst, geen wildcards
# CORS_ORIGINS=http://localhost:8000
# Inlogcookie alleen via HTTPS (Secure): auto = als de verbinding HTTPS is.
# Achter een eigen TLS-proxy die over HTTP naar de stack doorstuurt: true
# COOKIE_SECURE=auto
# Maximaal aantal verzoeken per minuut per IP-adres op chat en AI-teksten; 0 = geen limiet
# LLM_RATE_LIMIT=60

# ─── Optioneel: Keycloak (profiel keycloak) ──────────────
# Inloggen via OIDC en machineclients voor ETL's; zie docs/9-beheer/installatie.md.
# Aanzetten: COMPOSE_PROFILES=keycloak en beide wachtwoorden invullen (openssl rand -hex 24).
# COMPOSE_PROFILES=keycloak
# Wachtwoord van de tijdelijke beheerder (admin) in de admin-console op /auth/admin
# KEYCLOAK_ADMIN_PASSWORD=
# Wachtwoord van de databaserol keycloak
# KEYCLOAK_DB_PASSWORD=
# Hostnaam of volledige URL waarop gebruikers Keycloak bereiken (bij HTTPS: https://<host>/auth)
# KEYCLOAK_HOSTNAME=localhost

# ─── AI (optioneel) ──────────────────────────────────────
# Zonder AI werken kaart, Kompas en rapporten gewoon. Model en server kies je in
# Beheer → AI Configuratie; die instelling gaat voor wat hier staat.
#
# Lokaal met Ollama (standaard; data blijft binnen de organisatie)
# OLLAMA_HOST=http://host.docker.internal:11434
# Alleen terugval als er in Beheer niets is ingesteld; kies een *-instruct-variant
# OLLAMA_MODEL=qwen3:30b-instruct
# Denk-modus van redeneermodellen; aan = minutenlang wachten op antwoord
# LLM_THINK=false
# Alleen bij api_type=openai; leeg = het veld niet meesturen
# LLM_REASONING_EFFORT=none
#
# Via de LiteLLM-gateway (docker compose --profile llm-gateway up -d).
# Zelf gekozen sleutel die met sk- begint; LLM_API_KEY krijgt dezelfde waarde:
#   python -c "import secrets; print('sk-' + secrets.token_hex(24))"
# LITELLM_MASTER_KEY=
# LLM_API_KEY=
#
# Externe aanbieders achter de gateway; alleen invullen wat je gebruikt.
# Kiezen met: docker compose exec backend python scripts/llm/kies_provider.py <naam>
# LET OP (AVG/IAMA): vragen en gebiedsdata gaan dan naar de aanbieder.
# Zonder verwerkersovereenkomst alleen met demodata testen.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Gemini: https://aistudio.google.com/apikey (gratis, lage limieten)
# GEMINI_API_KEY=

# ─── Use cases (python -m omnitwin.usecases) ─────────────
# Extra domeinen (kommagescheiden) waarvan bronadapters via https mogen downloaden,
# naast de vaste lijst in src/omnitwin/bronadapters (CBS, PDOK, RIVM, Klimaateffectatlas).
# OMNITWIN_BRON_DOMEINEN=

# ─── Alleen voor ontwikkelaars (scripts op de host) ──────
# DATABASE_HOST=localhost
# DATABASE_PORT=5433
# DATABASE_NAME=omnitwin_db
# DATABASE_USER=omnitwin_user
# DATABASE_SSLMODE=prefer
