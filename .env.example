# D-OmniTwin Environment Configuration — TEMPLATE
# Kopieer dit bestand naar .env en vul de waarden in:
#   cp .env.example .env
#
# ⚠️ COMMIT NOOIT het .env bestand! Alleen dit .env.example bestand hoort op Git.

# ─── Database ────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=omnitwin_db
DATABASE_USER=omnitwin_user
DATABASE_PASSWORD=<jouw-database-wachtwoord>
DATABASE_SSLMODE=prefer  # 'require' voor productie, 'prefer' voor lokale ontwikkeling

# ─── API Security ─────────────────────────────────────────
# Genereer met: openssl rand -base64 32
SECRET_KEY=<genereer-met-openssl-rand-base64-32>

# Toegestane origins voor CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Mapbox ───────────────────────────────────────────────
# Haal je token op via: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=pk.eyJ1IjoiPGpvdXctZ2VicnVpa2Vycz4i...
MAPBOX_STYLE=mapbox://styles/mapbox/light-v10

# ─── App Instellingen ─────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO

# ─── Admin Panel ──────────────────────────────────────────
# Genereer met: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=<genereer-met-python-secrets-token-hex-32>

# ─── Ollama / Lokale AI (optioneel) ───────────────────────
# Standaard: http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:30b
