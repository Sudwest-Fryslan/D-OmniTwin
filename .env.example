# D-OmniTwin — configuratie
#
#   cp .env.example .env      en vul hieronder DATABASE_PASSWORD in.
#
# Al het andere heeft een werkende standaard. Commit .env nooit.
# Geheimen genereren: openssl rand -hex 24   (alleen letters en cijfers gebruiken)
# Commentaar staat altijd op een eigen regel: tekst achter een waarde wordt soms als waarde gelezen.

# ─── Verplicht ───────────────────────────────────────────
DATABASE_PASSWORD=

# ─── Aanbevolen ──────────────────────────────────────────
# Wachtwoord van het eerste beheeraccount (gebruiker: admin).
# Leeg = er wordt eenmalig een wachtwoord gegenereerd, te vinden met: docker compose logs db-init
ADMIN_PASSWORD=

# Installatie: alleen de installatie-instellingen laden.
# Ontwikkelaars: deze regel weghalen (dan wordt ook docker-compose.override.yml geladen).
COMPOSE_FILE=docker-compose.yml

# Zonder HTTPS moet dit op true staan, anders werkt inloggen in de browser niet. Met HTTPS: false.
DEBUG=true

# ─── Optioneel (weghalen van # = aanzetten; de standaardwaarde staat erbij) ─
# Poort op de host
# OMNITWIN_HTTP_PORT=80
# Demodata laden bij de eerste start (false = product zonder data, klaar voor eigen data)
# LOAD_SAMPLE_DATA=true
# Logniveau: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# Naam van het eerste beheeraccount
# ADMIN_USER=admin
# Alleen voor scripts (header X-Admin-Key); leeg = uitgeschakeld
# ADMIN_API_KEY=
# Alleen nodig voor meerdere installaties op één machine
# COMPOSE_PROJECT_NAME=d-omnitwin
# Alleen als andere websites de API aanroepen
# CORS_ORIGINS=http://localhost:8000

# ─── AI (optioneel) ──────────────────────────────────────
# Zonder AI werken kaart, Kompas en rapporten gewoon. Model en server kies je in
# Beheer → AI Configuratie; die instelling gaat voor wat hier staat.
#
# Lokaal met Ollama (standaard; data blijft binnen de organisatie)
# OLLAMA_HOST=http://host.docker.internal:11434
# Alleen terugval als er in Beheer niets is ingesteld; kies een *-instruct-variant
# OLLAMA_MODEL=qwen3:30b-instruct

# ─── Alleen voor ontwikkelaars (scripts op de host) ──────
# DATABASE_HOST=localhost
# DATABASE_PORT=5433
# DATABASE_NAME=omnitwin_db
# DATABASE_USER=omnitwin_user
# DATABASE_SSLMODE=prefer
# Admin gebruiker (applicatie login)
ADMIN_USER=admin
ADMIN_PASSWORD=<jouw-admin-wachtwoord>

# ─── Ollama / Lokale AI (optioneel) ───────────────────────
# Vanuit de backend-container is de host bereikbaar als host.docker.internal (extra_hosts in docker-compose.yml); draai je de backend buiten Docker, gebruik dan http://localhost:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:30b

# ─── LLM-koppeling: Ollama of OpenAI-compatibel (ADR 0001) ─
# Welke server de app gebruikt staat in de tabel llm_config (Admin → AI Configuratie):
#   api_type=ollama  Ollama-eigen API (standaard, zoals altijd)
#   api_type=openai  OpenAI Chat Completions: Ollama /v1, vLLM, LM Studio, LiteLLM, ...
# Alleen voor api_type=openai: API-sleutel als Bearer-token. Nooit in de database zetten.
# Via de LiteLLM-gateway: gebruik hier dezelfde waarde als LITELLM_MASTER_KEY.
LLM_API_KEY=
# Denk-modus van redeneermodellen (Qwen3, DeepSeek-R1). Standaard uit: korte teksten
# hebben geen redeneerstap nodig en denken kost minuten. true = het model beslist zelf.
# LLM_THINK=false
# Alleen api_type=openai: reasoning_effort bij denk-modus uit (standaard none).
# Leeg (LLM_REASONING_EFFORT=) laat het veld weg, voor servers die het weigeren.
# LLM_REASONING_EFFORT=none

# Optionele LiteLLM-gateway: docker compose --profile llm-gateway up -d
# Stuurt standaard door naar OLLAMA_HOST/OLLAMA_MODEL (deploy/litellm/config.yaml).
# Zet daarna in llm_config: api_type=openai, api_url=http://llm-gateway:4000,
# model_name=d-omnitwin-default.
# Moet met sk- beginnen. Genereer met: python -c "import secrets; print('sk-' + secrets.token_hex(24))"
LITELLM_MASTER_KEY=

# ─── E-mail Alerts (Sprint 17C — nog te implementeren, zie Issue #10) ────────
# Vereist eigen SMTP-server. Laat leeg om alerts uit te schakelen.
LOG_ALERT_ENABLED=false
LOG_ALERT_TO=beheer@jouwdomein.nl
SMTP_HOST=mail.jouwdomein.nl
SMTP_PORT=587
SMTP_USER=alerts@jouwdomein.nl
SMTP_PASS=<smtp-wachtwoord>
SMTP_FROM=D-OmniTwin Alerts <alerts@jouwdomein.nl>
