# Niet in de image: secrets, VCS en lokale/dev-artefacten.
# Let op: in dev mount docker-compose.override.yml de repo over /app; dit bestand
# geldt voor de image zelf (installatie via docker-compose.yml, Docker Hub).

# Secrets
.env
.env.*
!.env.example

# Versiebeheer en tooling
.git
.github
.claude
.vscode
.idea

# Python-artefacten
**/__pycache__
**/*.pyc
.pytest_cache
.venv
venv

# Node-artefacten
**/node_modules

# Lokale output
logs
exports
obsolete

# Frontend en beheeromgeving: eigen image (web.Dockerfile, #408). De backend leest alleen de
# thema's (themalijst, favicon-kleuren) en de afbeeldingen (beeldmerk, keuze van footer-logo's).
admin-panel
static
!static/css/themes
!static/images
